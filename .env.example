# Copy to .env.local for `npm run dev`. Never commit real keys.

# Admin panel / student portal API.
# Dev: `npm run dev` proxies /api/v1 to API_URL (same origin, so the refresh cookie works).
# Production: vercel.json rewrites /api/v1/* to the Render backend instead.
API_URL=https://tapovan-api.onrender.com

# true = answer /api/v1 from the in-browser mocks (src/portal/mocks) instead of API_URL.
# Never set this in Vercel: it would make production use mock data.
VITE_API_MOCK=false

# Admissions enquiry form (api/enquiry.ts, and the dev middleware in vite.config.ts).
RESEND_API_KEY=
ENQUIRY_FROM=
ENQUIRY_TO=
